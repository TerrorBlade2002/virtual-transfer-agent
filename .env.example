# =============================================================================
# Retell VTA Webhook — environment variables
# =============================================================================
# Copy this file to `.env` for local development and fill in the values.
# On Railway, set these in the project's Variables UI instead — dotenv
# silently no-ops in production because no `.env` file is present there.
# `.env` is git-ignored (see .gitignore). Never commit real secrets.
# =============================================================================

# -- REQUIRED for admin endpoints ---------------------------------------------
# Master token for admin-tier API access (/admin/*, /campaign/upload,
# /campaign/activate, /dispositions/csv?date=...).
# Generate a strong random value: `openssl rand -hex 32`
# If unset, every admin endpoint returns HTTP 503 and the server logs a warning
# on startup. The app still serves the existing Retell flow without it.
CAMPAIGN_ADMIN_TOKEN=

# -- Optional -----------------------------------------------------------------
# How many days uploaded campaign CSVs are retained before automatic pruning.
CAMPAIGN_RETENTION_DAYS=7

# Path to the default contacts file (used when no date-specific CSV exists).
CSV_FILE=./contacts.csv

# Directory for runtime state (campaign-state.json, uploads/, user-tokens.json).
DATA_DIR=./data

# HTTP port the server binds to. Railway overrides this with its own PORT.
PORT=3000

# If "true", loading a new campaign via /campaign/load triggers a
# process restart. Leave unset or "false" unless you know you need it.
AUTO_RESTART_ON_CAMPAIGN_LOAD=false
